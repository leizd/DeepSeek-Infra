{
  "source": "offline retained Python plan_for_preset and auto_signal_categories",
  "cases": [
    {
      "preset": "full",
      "payload": {
        "messages": [
          {
            "role": "user",
            "content": "inspect"
          }
        ]
      },
      "expected": {
        "agents": [
          {
            "id": "researcher",
            "task": "核查事实、背景和可能需要搜索的信息"
          },
          {
            "id": "coder",
            "task": "分析代码、架构、实现路径和工程风险",
            "depends_on": [
              "researcher"
            ]
          },
          {
            "id": "reasoner",
            "task": "梳理推理链路、边界条件和可执行方案",
            "depends_on": [
              "researcher"
            ]
          },
          {
            "id": "critic",
            "task": "检查方案风险、遗漏和反例",
            "depends_on": [
              "researcher",
              "coder",
              "reasoner"
            ]
          }
        ],
        "label": "完整 4-Agent"
      }
    },
